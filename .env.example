# Maxxing environment overrides (copy to .env and adjust; never commit .env)
# Maxxing never reads or logs .env contents — this file is documentation only.

# Where the terrain store and mission directories live (default: ~/.maxxing)
MAXXING_HOME=

# Model for every agent call (default: claude-sonnet-4-6)
MAXXING_MODEL=

# Terrain Gate revise-loop cap, 1-10 (default: 3)
MAXXING_MAX_GATE_ROUNDS=

# default | acceptEdits | plan | bypassPermissions (default: acceptEdits)
MAXXING_PERMISSION_MODE=

# Required for live runs unless you use Claude Code login auth.
# Maxxing never prints or stores this value.
ANTHROPIC_API_KEY=
