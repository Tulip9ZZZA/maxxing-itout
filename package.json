{
  "name": "maxxing",
  "version": "2.0.0",
  "private": true,
  "description": "A just-in-time munitions factory for self-learners: scout the terrain through five intelligence lenses, close every gap at the Terrain Gate, then execute.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "maxxing": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "maxxing": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
